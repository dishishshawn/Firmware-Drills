// Practice mode for the drills folder: no autocomplete, no AI edit predictions, no
// auto-closed brackets. Error squiggles stay on (clangd reads compile_flags.txt).
// To get the rest of the help back, delete this file.
{
  "show_completions_on_input": false,
  "show_edit_predictions": false,
  "use_autoclose": false,
  "auto_signature_help": false,
  "inlay_hints": { "enabled": false },
  "format_on_save": "off",
  "tab_size": 4,
  "languages": {
    "C++": {
      "enable_language_server": true,
      "format_on_save": "off",
      "tab_size": 4
    }
  }
}
